# -----------------------------------------------------------------------------
# Grandmaster configuration
# Copy to `.env.local` for local development; set the same variables in your
# hosting provider (e.g. Vercel → Project → Settings → Environment Variables).
# -----------------------------------------------------------------------------

# Supabase project URL — Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public client key. Either the new "publishable" key (sb_publishable_…) or the
# legacy "anon" JWT. Safe to expose to browsers — Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# SERVER ONLY — never prefix with NEXT_PUBLIC_ and never commit it.
# The "secret" key (sb_secret_…) or legacy "service_role" JWT. Used only by the
# move/action API routes to write validated game state.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of this site, used in email links (sign-up confirmation, password
# reset). Must also be allowed under Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
