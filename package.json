{
  "name": "grandmaster-chess",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "stack:start": "./scripts/local-stack/start.sh",
    "stack:stop": "./scripts/local-stack/stop.sh",
    "db:setup-sql": "(printf '%s\\n' '-- Grandmaster: complete database setup, generated from supabase/migrations (npm run db:setup-sql).' '-- Paste this whole file into the Supabase SQL editor and run it once.' ''; cat supabase/migrations/*.sql) > supabase/setup.sql"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "chess.js": "^1.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "description": "Real-time multiplayer chess on a 3D board \u2014 Next.js, React Three Fiber, chess.js and Supabase.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  }
}
